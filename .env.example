# --- GitHub Webhook Integration ---
# Used to verify incoming webhook payloads using HMAC SHA-256
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# --- GitHub Authentication ---
# Personal Access Token for the ANAKIN agent to post comments and commit patches
GITHUB_TOKEN=ghp_your_personal_access_token_here

# --- AI Security Agent (ANAKIN Track) ---
# Used for parsing telemetry and generating attack graphs / remediation patches
OPENAI_API_KEY=sk-your_openai_api_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# --- Core Dependencies ---
# PostgreSQL connection string for the backend orchestrator & telemetry
DATABASE_URL=postgresql://prison:prison_secure_pass_2026@localhost:5432/prison

# Redis connection string for queuing and event stream
REDIS_URL=redis://localhost:6379/0

# --- Decoy Credentials (MANTITUP Track) ---
# Synthetic honeypots injected into microVMs to trap malicious actors
HONEYPOT_AWS_KEY=AKIA_PRISON_DECOY_9982
HONEYPOT_JWT_SECRET=ey_prison_decoy_jwt_token_production_fake

# --- Frontend Dashboard ---
# API URL for the Next.js frontend to communicate with the Orchestrator
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8001
